<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Tyller City — GTA RP</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Barlow+Condensed:wght@400;600;700&family=Barlow:wght@300;400;500&display=swap" rel="stylesheet"/>
<style>
:root{--pd:#1a0a2e;--pm:#3b1f6b;--pv:#8b2fc9;--pb:#b44fff;--pg:#d08fff;--w:#f0eaf8;--g:#9a8baf;}
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box;}
body{background:var(--pd);color:var(--w);font-family:'Barlow',sans-serif;overflow-x:hidden;}
body::before{content:'';position:fixed;inset:0;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");opacity:.4;pointer-events:none;z-index:0;}

/* ── NAV ── */
nav{position:fixed;top:0;left:0;right:0;z-index:100;background:rgba(26,10,46,.92);backdrop-filter:blur(12px);border-bottom:1px solid #8b2fc933;padding:0 24px;}
.nav-inner{max-width:1200px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;height:60px;flex-wrap:wrap;gap:8px;}
.nav-logo{font-family:'Bebas Neue',sans-serif;font-size:22px;letter-spacing:2px;color:var(--w);cursor:pointer;}
.nav-logo span{color:var(--pb);}
.nav-links{display:flex;align-items:center;gap:6px;flex-wrap:wrap;}
.nav-btn{font-family:'Barlow Condensed',sans-serif;font-size:13px;font-weight:600;letter-spacing:2px;text-transform:uppercase;padding:7px 14px;border-radius:3px;cursor:pointer;border:none;text-decoration:none;transition:all .2s;background:transparent;color:var(--g);}
.nav-btn:hover{color:var(--w);background:#8b2fc922;}
.nav-btn.active{color:var(--pb);}
.nav-btn-discord{background:var(--pv);color:var(--w)!important;padding:7px 16px;}
.nav-btn-discord:hover{background:var(--pb);}
.nav-btn-chat{background:#2a1050;border:1px solid var(--pv);color:var(--pg)!important;}
.nav-btn-chat:hover{background:var(--pv);color:var(--w)!important;}

/* ── PAGES ── */
.page{display:none;padding-top:60px;min-height:100vh;position:relative;z-index:1;}
.page.active{display:block;}

/* ── HERO ── */
.hero{min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:80px 24px 60px;background:radial-gradient(ellipse 70% 60% at 50% 30%,#4a1a8a55 0%,transparent 70%),radial-gradient(ellipse 40% 40% at 80% 80%,#6b0fc833 0%,transparent 60%);}
.hero::after{content:'';position:absolute;bottom:-2px;left:0;right:0;height:120px;background:linear-gradient(to bottom,transparent,var(--pd));}
.hero-tag{font-family:'Barlow Condensed',sans-serif;font-size:13px;font-weight:600;letter-spacing:5px;text-transform:uppercase;color:var(--pb);margin-bottom:20px;animation:fadeUp .6s ease forwards .2s;opacity:0;}
.hero-title{font-family:'Bebas Neue',sans-serif;font-size:clamp(60px,12vw,130px);line-height:.95;letter-spacing:2px;color:var(--w);text-shadow:0 0 40px #b44fff88,0 0 80px #8b2fc944;animation:fadeUp .7s ease forwards .4s;opacity:0;}
.hero-title .small-x{color:var(--pb);font-size:.5em;vertical-align:middle;}
.hero-sub{font-family:'Barlow Condensed',sans-serif;font-size:clamp(16px,3vw,24px);font-weight:400;color:var(--g);letter-spacing:3px;text-transform:uppercase;margin-top:10px;animation:fadeUp .7s ease forwards .6s;opacity:0;}
.hero-desc{max-width:540px;font-size:16px;line-height:1.7;color:#c4b4d8;margin:28px auto 0;font-weight:300;animation:fadeUp .7s ease forwards .8s;opacity:0;}
.cta-group{display:flex;gap:14px;flex-wrap:wrap;justify-content:center;margin-top:40px;animation:fadeUp .7s ease forwards 1s;opacity:0;}
.btn{font-family:'Barlow Condensed',sans-serif;font-size:14px;font-weight:700;letter-spacing:3px;text-transform:uppercase;padding:13px 32px;border-radius:3px;cursor:pointer;text-decoration:none;transition:all .25s;border:none;display:inline-block;}
.btn-primary{background:var(--pv);color:var(--w);box-shadow:0 0 24px #8b2fc966;}
.btn-primary:hover{background:var(--pb);box-shadow:0 0 40px #b44fff99;transform:translateY(-2px);}
.btn-outline{background:transparent;color:var(--pg);border:1.5px solid #8b2fc9;}
.btn-outline:hover{background:#8b2fc922;border-color:var(--pb);transform:translateY(-2px);}
.btn-discord-big{background:#5865F2;color:#fff;box-shadow:0 0 24px #5865F266;}
.btn-discord-big:hover{background:#6d78f5;transform:translateY(-2px);}

/* ── SECTION COMMONS ── */
.section{padding:80px 24px;max-width:1000px;margin:0 auto;}
.section-label{font-family:'Barlow Condensed',sans-serif;font-size:12px;letter-spacing:5px;text-transform:uppercase;color:var(--pb);margin-bottom:10px;}
.section-title{font-family:'Bebas Neue',sans-serif;font-size:clamp(34px,6vw,60px);line-height:1;margin-bottom:18px;text-shadow:0 0 20px #8b2fc944;}
.section-text{font-size:15px;line-height:1.8;color:#c4b4d8;font-weight:300;max-width:680px;}
.glow-line{width:80px;height:3px;background:linear-gradient(to right,var(--pv),var(--pb));border-radius:2px;margin:16px 0 28px;box-shadow:0 0 12px #b44fff66;}
.divider{display:flex;align-items:center;gap:16px;padding:0 40px;margin:6px 0;}
.divider-line{flex:1;height:1px;background:linear-gradient(to right,transparent,#8b2fc966,transparent);}
.divider-icon{color:var(--pb);font-size:16px;}

/* ── FEATURES ── */
.features{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:18px;margin-top:44px;}
.feature-card{background:linear-gradient(135deg,#2a1050 0%,#1e0c3a 100%);border:1px solid #8b2fc933;border-radius:6px;padding:28px 24px;transition:all .3s;position:relative;overflow:hidden;}
.feature-card::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(to right,transparent,var(--pv),transparent);opacity:0;transition:opacity .3s;}
.feature-card:hover{border-color:#8b2fc966;transform:translateY(-4px);box-shadow:0 16px 40px #1a0a2e88;}
.feature-card:hover::before{opacity:1;}
.feature-icon{font-size:26px;margin-bottom:14px;}
.feature-title{font-family:'Barlow Condensed',sans-serif;font-size:18px;font-weight:700;letter-spacing:1px;text-transform:uppercase;margin-bottom:8px;}
.feature-text{font-size:13px;line-height:1.7;color:var(--g);}

/* ── RAFFLE ── */
.raffle-section{background:linear-gradient(135deg,#2a1050,#3b1f6b44);border:1px solid #8b2fc944;border-radius:8px;padding:56px 40px;text-align:center;position:relative;overflow:hidden;}
.raffle-section::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse 60% 60% at 50% 0%,#8b2fc922,transparent);}
.raffle-section>*{position:relative;}
.raffle-badge{display:inline-block;background:var(--pv);color:var(--w);font-family:'Barlow Condensed',sans-serif;font-size:11px;font-weight:700;letter-spacing:4px;text-transform:uppercase;padding:5px 16px;border-radius:2px;margin-bottom:20px;animation:pulse 2.5s ease infinite;}
.raffle-title{font-family:'Bebas Neue',sans-serif;font-size:clamp(36px,7vw,72px);line-height:1;margin-bottom:14px;text-shadow:0 0 30px #b44fff66;}
.raffle-text{font-size:15px;color:#c4b4d8;max-width:500px;margin:0 auto 32px;line-height:1.7;}
.steps{display:flex;flex-wrap:wrap;justify-content:center;gap:10px;margin-bottom:36px;}
.step{display:flex;align-items:center;gap:8px;background:#1a0a2e;border:1px solid #8b2fc944;border-radius:4px;padding:9px 18px;}
.step-num{font-family:'Bebas Neue',sans-serif;font-size:20px;color:var(--pb);line-height:1;}
.step-label{font-family:'Barlow Condensed',sans-serif;font-size:13px;font-weight:600;letter-spacing:1px;}

/* ── PAGE WRAPPER ── */
.page-wrap{max-width:900px;margin:0 auto;padding:40px 24px;}
.page-title{font-family:'Bebas Neue',sans-serif;font-size:clamp(36px,6vw,60px);margin-bottom:8px;text-shadow:0 0 20px #8b2fc944;}
.page-sub{font-size:14px;color:var(--g);margin-bottom:32px;font-family:'Barlow Condensed',sans-serif;letter-spacing:2px;text-transform:uppercase;}

/* ── AUTH MODAL ── */
.modal-bg{position:fixed;inset:0;background:#0008;z-index:200;display:flex;align-items:center;justify-content:center;padding:20px;}
.modal-bg.hidden{display:none;}
.modal{background:linear-gradient(135deg,#2a1050,#1a0a2e);border:1px solid #8b2fc966;border-radius:8px;padding:40px;width:100%;max-width:420px;}
.modal-title{font-family:'Bebas Neue',sans-serif;font-size:36px;margin-bottom:6px;text-shadow:0 0 16px #b44fff66;}
.modal-sub{font-size:13px;color:var(--g);margin-bottom:28px;font-family:'Barlow Condensed',sans-serif;letter-spacing:1px;}
.form-group{margin-bottom:18px;}
.form-label{font-family:'Barlow Condensed',sans-serif;font-size:13px;letter-spacing:2px;text-transform:uppercase;color:var(--g);margin-bottom:6px;display:block;}
.form-input{width:100%;background:#1a0a2e;border:1px solid #8b2fc955;border-radius:4px;padding:11px 14px;color:var(--w);font-size:14px;font-family:'Barlow',sans-serif;outline:none;transition:border .2s;}
.form-input:focus{border-color:var(--pv);}
.form-error{color:#ff6b6b;font-size:13px;margin-top:6px;font-family:'Barlow Condensed',sans-serif;}
.modal-switch{text-align:center;margin-top:16px;font-size:13px;color:var(--g);}
.modal-switch a{color:var(--pb);cursor:pointer;text-decoration:underline;}
.modal-close{position:absolute;top:14px;right:18px;background:none;border:none;color:var(--g);font-size:20px;cursor:pointer;}

/* ── CHAT ── */
.chat-container{display:flex;flex-direction:column;height:calc(100vh - 60px);}
.chat-header{background:#2a1050;border-bottom:1px solid #8b2fc933;padding:14px 24px;display:flex;align-items:center;gap:12px;}
.chat-header-title{font-family:'Bebas Neue',sans-serif;font-size:24px;letter-spacing:2px;}
.chat-header-sub{font-size:12px;color:var(--g);font-family:'Barlow Condensed',sans-serif;letter-spacing:1px;text-transform:uppercase;}
.chat-online{background:#22c55e;width:8px;height:8px;border-radius:50%;margin-left:auto;}
.chat-messages{flex:1;overflow-y:auto;padding:20px 24px;display:flex;flex-direction:column;gap:14px;}
.chat-messages::-webkit-scrollbar{width:5px;}
.chat-messages::-webkit-scrollbar-track{background:#1a0a2e;}
.chat-messages::-webkit-scrollbar-thumb{background:#8b2fc9;border-radius:3px;}
.chat-msg{display:flex;gap:12px;align-items:flex-start;}
.chat-avatar{width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,var(--pv),var(--pm));display:flex;align-items:center;justify-content:center;font-family:'Bebas Neue',sans-serif;font-size:16px;flex-shrink:0;border:2px solid #8b2fc944;}
.chat-avatar.admin{border-color:#ffd700;background:linear-gradient(135deg,#8b6914,#c9991a);}
.chat-msg-body{}
.chat-msg-header{display:flex;align-items:baseline;gap:8px;margin-bottom:3px;}
.chat-msg-name{font-family:'Barlow Condensed',sans-serif;font-size:14px;font-weight:700;letter-spacing:1px;color:var(--pb);}
.chat-msg-name.admin-name{color:#ffd700;}
.chat-msg-time{font-size:11px;color:#5a4a6e;}
.chat-msg-text{font-size:14px;line-height:1.6;color:#c4b4d8;}
.chat-input-area{padding:16px 24px;border-top:1px solid #8b2fc933;background:#1e0c3a;}
.chat-input-row{display:flex;gap:10px;}
.chat-input{flex:1;background:#2a1050;border:1px solid #8b2fc955;border-radius:4px;padding:12px 16px;color:var(--w);font-size:14px;font-family:'Barlow',sans-serif;outline:none;transition:border .2s;}
.chat-input:focus{border-color:var(--pv);}
.chat-send{background:var(--pv);border:none;color:var(--w);padding:12px 20px;border-radius:4px;cursor:pointer;font-family:'Barlow Condensed',sans-serif;font-size:14px;font-weight:700;letter-spacing:2px;text-transform:uppercase;transition:background .2s;}
.chat-send:hover{background:var(--pb);}
.chat-blocked{text-align:center;padding:40px;color:var(--g);font-family:'Barlow Condensed',sans-serif;letter-spacing:2px;text-transform:uppercase;}
.chat-blocked .block-icon{font-size:48px;margin-bottom:16px;}
.admin-del{background:none;border:none;color:#ff4444;cursor:pointer;font-size:12px;margin-left:8px;opacity:0;transition:opacity .2s;}
.chat-msg:hover .admin-del{opacity:1;}

/* ── QUEM SOMOS ── */
.about-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:20px;margin-top:32px;}
.about-card{background:linear-gradient(135deg,#2a1050,#1e0c3a);border:1px solid #8b2fc933;border-radius:6px;padding:28px;}
.about-card h3{font-family:'Bebas Neue',sans-serif;font-size:26px;margin-bottom:10px;color:var(--pb);}
.about-card p{font-size:14px;line-height:1.8;color:#c4b4d8;}
.team-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:16px;margin-top:24px;}
.team-card{background:#2a1050;border:1px solid #8b2fc933;border-radius:6px;padding:24px;text-align:center;}
.team-avatar{width:60px;height:60px;border-radius:50%;background:linear-gradient(135deg,var(--pv),var(--pm));display:flex;align-items:center;justify-content:center;font-family:'Bebas Neue',sans-serif;font-size:24px;margin:0 auto 12px;border:2px solid var(--pb);}
.team-name{font-family:'Barlow Condensed',sans-serif;font-size:16px;font-weight:700;letter-spacing:1px;}
.team-role{font-size:12px;color:var(--pb);font-family:'Barlow Condensed',sans-serif;letter-spacing:2px;text-transform:uppercase;margin-top:4px;}

/* ── COINS / VIP ── */
.coins-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:18px;margin-top:32px;}
.coin-card{background:linear-gradient(135deg,#2a1050,#1e0c3a);border:1px solid #8b2fc933;border-radius:8px;padding:28px 20px;text-align:center;transition:all .3s;position:relative;overflow:hidden;}
.coin-card.featured{border-color:var(--pb);box-shadow:0 0 30px #b44fff33;}
.coin-card.featured::before{content:'MAIS POPULAR';position:absolute;top:12px;right:-20px;background:var(--pb);color:#fff;font-family:'Barlow Condensed',sans-serif;font-size:10px;font-weight:700;letter-spacing:2px;padding:3px 30px;transform:rotate(45deg);transform-origin:center;}
.coin-card:hover{transform:translateY(-4px);border-color:#8b2fc966;}
.coin-icon{font-size:36px;margin-bottom:12px;}
.coin-name{font-family:'Bebas Neue',sans-serif;font-size:24px;letter-spacing:1px;margin-bottom:6px;}
.coin-amount{font-size:14px;color:var(--g);margin-bottom:14px;font-family:'Barlow Condensed',sans-serif;}
.coin-price{font-family:'Bebas Neue',sans-serif;font-size:32px;color:var(--pb);margin-bottom:4px;}
.coin-price-sub{font-size:12px;color:var(--g);font-family:'Barlow Condensed',sans-serif;margin-bottom:16px;}
.coin-features{list-style:none;margin-bottom:20px;}
.coin-features li{font-size:13px;color:#c4b4d8;padding:4px 0;border-bottom:1px solid #8b2fc922;}
.coin-features li:last-child{border:none;}
.vip-note{background:#2a1050;border:1px solid #8b2fc933;border-radius:6px;padding:20px;margin-top:24px;font-size:14px;color:#c4b4d8;line-height:1.7;}
.vip-note strong{color:var(--pb);}

/* ── DENÚNCIAS ── */
.denuncias-list{margin-top:28px;display:flex;flex-direction:column;gap:14px;}
.denuncia-card{background:linear-gradient(135deg,#2a1050,#1e0c3a);border:1px solid #8b2fc933;border-radius:6px;padding:20px 24px;}
.denuncia-header{display:flex;align-items:center;gap:10px;margin-bottom:10px;flex-wrap:wrap;}
.denuncia-status{font-family:'Barlow Condensed',sans-serif;font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;padding:3px 10px;border-radius:2px;}
.status-pending{background:#f59e0b22;color:#f59e0b;border:1px solid #f59e0b55;}
.status-approved{background:#22c55e22;color:#22c55e;border:1px solid #22c55e55;}
.status-rejected{background:#ef444422;color:#ef4444;border:1px solid #ef444455;}
.denuncia-title{font-family:'Barlow Condensed',sans-serif;font-size:16px;font-weight:700;letter-spacing:1px;}
.denuncia-meta{font-size:12px;color:var(--g);margin-bottom:8px;font-family:'Barlow Condensed',sans-serif;letter-spacing:1px;}
.denuncia-text{font-size:13px;color:#c4b4d8;line-height:1.6;margin-bottom:10px;}
.denuncia-video{font-size:12px;color:var(--pb);font-family:'Barlow Condensed',sans-serif;letter-spacing:1px;}
.admin-actions{display:flex;gap:8px;margin-top:12px;}
.btn-sm{font-family:'Barlow Condensed',sans-serif;font-size:12px;font-weight:700;letter-spacing:2px;text-transform:uppercase;padding:6px 14px;border-radius:3px;cursor:pointer;border:none;transition:all .2s;}
.btn-approve{background:#22c55e22;color:#22c55e;border:1px solid #22c55e55;}
.btn-approve:hover{background:#22c55e44;}
.btn-reject{background:#ef444422;color:#ef4444;border:1px solid #ef444455;}
.btn-reject:hover{background:#ef444444;}
.btn-delete-admin{background:#ff000022;color:#ff4444;border:1px solid #ff444455;}
.btn-delete-admin:hover{background:#ff000044;}
.denuncia-form{background:#2a1050;border:1px solid #8b2fc944;border-radius:8px;padding:28px;margin-top:28px;}
.denuncia-form h3{font-family:'Bebas Neue',sans-serif;font-size:28px;margin-bottom:20px;}
textarea.form-input{resize:vertical;min-height:100px;}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:14px;}

/* ── DIVULGAÇÃO ── */
.post-form{background:#2a1050;border:1px solid #8b2fc944;border-radius:8px;padding:24px;margin-bottom:28px;}
.post-form h3{font-family:'Bebas Neue',sans-serif;font-size:26px;margin-bottom:16px;}
.post-list{display:flex;flex-direction:column;gap:18px;}
.post-card{background:linear-gradient(135deg,#2a1050,#1e0c3a);border:1px solid #8b2fc933;border-radius:8px;padding:20px 24px;}
.post-card-header{display:flex;align-items:center;gap:10px;margin-bottom:14px;}
.post-avatar{width:38px;height:38px;border-radius:50%;background:linear-gradient(135deg,var(--pv),var(--pm));display:flex;align-items:center;justify-content:center;font-family:'Bebas Neue',sans-serif;font-size:16px;border:2px solid #8b2fc944;flex-shrink:0;}
.post-author{font-family:'Barlow Condensed',sans-serif;font-size:15px;font-weight:700;letter-spacing:1px;}
.post-time{font-size:11px;color:var(--g);}
.post-text{font-size:14px;line-height:1.7;color:#c4b4d8;margin-bottom:12px;}
.post-media{max-width:100%;border-radius:6px;margin-bottom:12px;border:1px solid #8b2fc933;}
.post-media-url{display:inline-block;font-size:12px;color:var(--pb);font-family:'Barlow Condensed',sans-serif;letter-spacing:1px;margin-bottom:12px;word-break:break-all;}
.post-actions{display:flex;align-items:center;gap:14px;padding-top:10px;border-top:1px solid #8b2fc922;}
.react-btn{background:none;border:none;cursor:pointer;font-size:14px;display:flex;align-items:center;gap:5px;color:var(--g);font-family:'Barlow Condensed',sans-serif;letter-spacing:1px;transition:all .2s;padding:4px 8px;border-radius:4px;}
.react-btn:hover{background:#8b2fc922;color:var(--w);}
.react-btn.liked{color:#ec4899;}
.react-btn.hearted{color:#ef4444;}
.comment-section{margin-top:14px;border-top:1px solid #8b2fc922;padding-top:14px;}
.comment{display:flex;gap:8px;margin-bottom:10px;}
.comment-avatar{width:28px;height:28px;border-radius:50%;background:linear-gradient(135deg,var(--pv),var(--pm));display:flex;align-items:center;justify-content:center;font-family:'Bebas Neue',sans-serif;font-size:12px;flex-shrink:0;border:1px solid #8b2fc944;}
.comment-body{}
.comment-name{font-family:'Barlow Condensed',sans-serif;font-size:13px;font-weight:700;color:var(--pb);}
.comment-text{font-size:13px;color:#c4b4d8;line-height:1.5;}
.comment-row{display:flex;gap:8px;margin-top:10px;}
.comment-input{flex:1;background:#1a0a2e;border:1px solid #8b2fc944;border-radius:4px;padding:8px 12px;color:var(--w);font-size:13px;font-family:'Barlow',sans-serif;outline:none;}
.comment-input:focus{border-color:var(--pv);}
.comment-send{background:var(--pv);border:none;color:var(--w);padding:8px 14px;border-radius:4px;cursor:pointer;font-family:'Barlow Condensed',sans-serif;font-size:13px;font-weight:700;letter-spacing:1px;text-transform:uppercase;}
.comment-send:hover{background:var(--pb);}
.del-post-btn{margin-left:auto;background:none;border:none;color:#ff4444;cursor:pointer;font-size:13px;opacity:.6;transition:opacity .2s;}
.del-post-btn:hover{opacity:1;}

/* ── TOAST ── */
