  const err = document.getElementById('login-error');
  // Admin check
  if(em === ADMIN_USER && pw === ADMIN_PASS) {
    currentUser = {name: 'Tyller [ADM MASTER]', email: ADMIN_USER, isAdmin: true};
    closeAuth(); onLogin(); showToast('✅ Logado como ADM MASTER'); return;
  }
  if(!users[em]) { err.textContent='E-mail não encontrado.'; err.style.display='block'; return; }
  if(users[em].pass !== pw) { err.textContent='Senha incorreta.'; err.style.display='block'; return; }
  currentUser = {name: users[em].name, email: em, isAdmin: false};
  err.style.display='none';
  closeAuth(); onLogin(); showToast('✅ Bem-vindo, ' + currentUser.name + '!');
}

function doRegister() {
  const name = document.getElementById('reg-name').value.trim();
  const em = document.getElementById('reg-email').value.trim();
  const pw = document.getElementById('reg-pass').value;
  const err = document.getElementById('reg-error');
  if(!name||!em||!pw) { err.textContent='Preencha todos os campos.'; err.style.display='block'; return; }
  if(!em.includes('@')) { err.textContent='E-mail inválido.'; err.style.display='block'; return; }
  if(pw.length<6) { err.textContent='Senha muito curta (mínimo 6 caracteres).'; err.style.display='block'; return; }
  if(users[em]) { err.textContent='E-mail já cadastrado.'; err.style.display='block'; return; }
  users[em] = {name, pass: pw};
  currentUser = {name, email: em, isAdmin: false};
  err.style.display='none';
  closeAuth(); onLogin(); showToast('🎉 Conta criada! Bem-vindo, ' + name + '!');
}

function onLogin() {
  updateNavLogin();
  renderChat();
  renderDenuncias();
  renderPosts();
}

function updateNavLogin() {
  // update nav to show logout
  let logoutBtn = document.getElementById('nav-logout-btn');
  if(currentUser && !logoutBtn) {
    const links = document.querySelector('.nav-links');
    const btn = document.createElement('button');
    btn.className = 'nav-btn';
    btn.id = 'nav-logout-btn';
    btn.style.color = '#ff6b6b';
    btn.textContent = '⏻ Sair';
    btn.onclick = doLogout;
    links.appendChild(btn);
  }
}

function doLogout() {
  currentUser = null;
  const lb = document.getElementById('nav-logout-btn');
  if(lb) lb.remove();
  renderChat(); renderDenuncias(); renderPosts();
  showToast('👋 Você saiu da conta.');
}

// ── CHAT ──
const sampleMessages = [
  {name:'Tyller [ADM MASTER]',isAdmin:true,text:'Bem-vindos ao chat oficial da Tyller City! 🎉',time:'10:00'},
  {name:'TylerFan',isAdmin:false,text:'Que servidor incrível, acabei de entrar!',time:'10:02'},
  {name:'CidadaoX',isAdmin:false,text:'Alguém me ajuda a entrar no Discord?',time:'10:05'},
  {name:'Tyller [ADM MASTER]',isAdmin:true,text:'Link no topo do site! Qualquer dúvida abre ticket.',time:'10:06'},
];

function renderChat() {
  const msgs = document.getElementById('chat-messages');
  const blocked = document.getElementById('chat-blocked');
  const inputArea = document.getElementById('chat-input-area');
  const userLabel = document.getElementById('chat-user-label');
  const onlineCount = document.getElementById('chat-online-count');

  if(!currentUser) {
    msgs.style.display = 'none';
    blocked.style.display = 'flex';
    blocked.style.flexDirection = 'column';
    blocked.style.alignItems = 'center';
    inputArea.style.display = 'none';
    return;
  }
  msgs.style.display = 'flex';
  blocked.style.display = 'none';
  inputArea.style.display = 'block';
  userLabel.textContent = currentUser.name;
  onlineCount.textContent = (Object.keys(users).length + 1) + ' online';

  const allMsgs = [...sampleMessages, ...chatMessages];
  msgs.innerHTML = allMsgs.map((m,i) => `
    <div class="chat-msg" id="cmsg-${i}">
      <div class="chat-avatar ${m.isAdmin?'admin':''}">${m.name.charAt(0).toUpperCase()}</div>
      <div class="chat-msg-body">
        <div class="chat-msg-header">
          <span class="chat-msg-name ${m.isAdmin?'admin-name':''}">${escHtml(m.name)}</span>
          <span class="chat-msg-time">${m.time}</span>
          ${currentUser.isAdmin&&!m.isAdmin?`<button class="admin-del" onclick="delChatMsg(${i})">🗑️ Apagar</button>`:''}
        </div>
        <p class="chat-msg-text">${escHtml(m.text)}</p>
      </div>
    </div>
  `).join('');
  msgs.scrollTop = msgs.scrollHeight;
}

function sendChat() {
  const inp = document.getElementById('chat-input');
  const txt = inp.value.trim();
  if(!txt || !currentUser) return;
  chatMessages.push({name: currentUser.name, isAdmin: currentUser.isAdmin, text: txt, time: now()});
  inp.value = '';
  renderChat();
}

function delChatMsg(i) {
  const allMsgs = [...sampleMessages, ...chatMessages];
  const idx = i - sampleMessages.length;
  if(idx >= 0) chatMessages.splice(idx, 1);
  renderChat();
  showToast('🗑️ Mensagem apagada.');
}

// ── DENÚNCIAS ──
const sampleDenuncias = [
  {id:1, autor:'Membro01', alvo:'MalfeitorXYZ', tipo:'RDM (Matar sem motivo)', desc:'Me matou sem nenhum motivo no spawn de forma aleatória.', video:'https://youtube.com', status:'pending', time:'08/05/2026'},
  {id:2, autor:'CidadaoZ', alvo:'HackerTop', tipo:'Hack / Trapaça', desc:'Jogador com teleport e vendo através de paredes durante a operação policial.', video:'https://streamable.com', status:'approved', time:'07/05/2026'},
];

function renderDenuncias() {
  const formBox = document.getElementById('denuncia-form-box');
  const note = document.getElementById('den-login-note');
  if(currentUser) {
    formBox.style.display = 'block';
    note.style.display = 'none';
    document.getElementById('den-autor').value = currentUser.name;
  } else {
    formBox.style.display = 'none';
    note.style.display = 'inline';
  }
  const all = [...sampleDenuncias, ...denuncias];
  const list = document.getElementById('denuncias-list');
  if(!all.length) { list.innerHTML = '<p style="color:var(--g);font-family:Barlow Condensed,sans-serif;letter-spacing:1px;text-transform:uppercase;font-size:14px;">Nenhuma denúncia registrada.</p>'; return; }
  list.innerHTML = all.map((d,i) => `
    <div class="denuncia-card">
      <div class="denuncia-header">
        <span class="denuncia-status ${d.status==='pending'?'status-pending':d.status==='approved'?'status-approved':'status-rejected'}">${d.status==='pending'?'Pendente':d.status==='approved'?'Aprovada':'Rejeitada'}</span>
        <span class="denuncia-title">${escHtml(d.tipo)}</span>
      </div>
      <p class="denuncia-meta">📅 ${d.time} · 👤 Denunciante: ${escHtml(d.autor)} · 🎯 Denunciado: ${escHtml(d.alvo)}</p>
      <p class="denuncia-text">${escHtml(d.desc)}</p>
      ${d.video?`<p class="denuncia-video">🎥 <a href="${d.video}" target="_blank" style="color:var(--pb);">Ver prova em vídeo</a></p>`:''}
      ${currentUser&&currentUser.isAdmin?`
      <div class="admin-actions">
        ${d.status!=='approved'?`<button class="btn-sm btn-approve" onclick="setDenStatus(${i},'approved')">✅ Aprovar</button>`:''}
        ${d.status!=='rejected'?`<button class="btn-sm btn-reject" onclick="setDenStatus(${i},'rejected')">❌ Rejeitar</button>`:''}
        <button class="btn-sm btn-delete-admin" onclick="delDen(${i})">🗑️ Apagar</button>
      </div>`:''}
    </div>
  `).join('');
}

async function enviarDenuncia() {
  if(!currentUser) { showAuth('login'); return; }
  const alvo = document.getElementById('den-alvo').value.trim();
  const tipo = document.getElementById('den-tipo').value;
  const desc = document.getElementById('den-desc').value.trim();
  const video = document.getElementById('den-video').value.trim();
  if(!alvo||!desc) { showToast('⚠️ Preencha todos os campos!'); return; }

  const WEBHOOK = 'https://discord.com/api/webhooks/1502498874474893372/LRbv_VQtXKSBrh1LzEeXixiUSTGOnxGI-BuwRTcggoMPNB5aX57X7VKCk0qZWYXQwfR2';

  const payload = {
    username: '🚨 Tyller City — Denúncias',
    avatar_url: 'https://i.imgur.com/4M34hi2.png',
    embeds: [{
      title: '🚨 Nova Denúncia Recebida',
      color: 0x8b2fc9,
      fields: [
        { name: '👤 Denunciante',  value: currentUser.name, inline: true },
        { name: '🎯 Denunciado',   value: alvo,             inline: true },
        { name: '⚠️ Tipo',         value: tipo,             inline: false },
        { name: '📋 Descrição',    value: desc,             inline: false },
        { name: '🎥 Prova em vídeo', value: video || 'Nenhuma prova enviada', inline: false },
      ],
      footer: { text: 'Tyller City · Sistema de Denúncias · ' + today() },
      thumbnail: { url: 'https://i.imgur.com/4M34hi2.png' }
    }]
  };

  try {
    const res = await fetch(WEBHOOK, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });
    if(res.ok || res.status === 204) {
      denuncias.push({id: Date.now(), autor: currentUser.name, alvo, tipo, desc, video, status:'pending', time: today()});
      document.getElementById('den-alvo').value='';
      document.getElementById('den-desc').value='';
      document.getElementById('den-video').value='';
      showToast('✅ Denúncia enviada! A staff foi notificada no Discord.');
      renderDenuncias();
    } else {
      showToast('⚠️ Erro ao notificar o Discord. Tente novamente.');
    }
  } catch(e) {
    // Salva localmente mesmo se o Discord falhar
    denuncias.push({id: Date.now(), autor: currentUser.name, alvo, tipo, desc, video, status:'pending', time: today()});
    document.getElementById('den-alvo').value='';
    document.getElementById('den-desc').value='';
    document.getElementById('den-video').value='';
    showToast('✅ Denúncia registrada! (Notificação Discord com falha)');
    renderDenuncias();
  }
}

function setDenStatus(i, status) {
  const all = [...sampleDenuncias, ...denuncias];
  const idx = i - sampleDenuncias.length;
  if(idx >= 0) denuncias[idx].status = status;
  else sampleDenuncias[i].status = status;
  renderDenuncias();
  showToast(status==='approved'?'✅ Denúncia aprovada.':'❌ Denúncia rejeitada.');
}

function delDen(i) {
  const idx = i - sampleDenuncias.length;
  if(idx >= 0) denuncias.splice(idx,1);
  else sampleDenuncias.splice(i,1);
  renderDenuncias();
  showToast('🗑️ Denúncia removida.');
}

// ── POSTS ──
const samplePosts = [
  {id:1, autor:'TyllerFan', text:'Que perseguição épica hoje com a polícia! Acabei fugindo e virando lenda da cidade 😂🚗💨', media:'', likes:12, hearts:7, comments:[{autor:'CidadaoX',text:'Irmão vi isso ao vivo, foi insano!'}], likedBy:[], heartedBy:[]},
  {id:2, autor:'Membro01', text:'Minha concessionária acabou de abrir! Venham comprar seus carros na Tyller City 🏎️', media:'', likes:5, hearts:3, comments:[], likedBy:[], heartedBy:[]},
];

function renderPosts() {
  const formBox = document.getElementById('post-form-box');
  const note = document.getElementById('div-login-note');
  if(currentUser) {
    formBox.style.display = 'block';
    note.style.display = 'none';
  } else {
    formBox.style.display = 'none';
    note.style.display = 'block';
  }
  const all = [...samplePosts, ...posts];
  const list = document.getElementById('post-list');
  if(!all.length) { list.innerHTML='<p style="color:var(--g);font-family:Barlow Condensed,sans-serif;letter-spacing:1px;text-transform:uppercase;font-size:14px;">Nenhuma publicação ainda. Seja o primeiro!</p>'; return; }
  list.innerHTML = all.map((p,i) => {
    const liked = currentUser&&p.likedBy.includes(currentUser.email);
    const hearted = currentUser&&p.heartedBy.includes(currentUser.email);
    const isImg = p.media && (p.media.match(/\.(jpg|jpeg|png|gif|webp)$/i) || p.media.includes('i.imgur') || p.media.includes('cdn.') || p.media.includes('image'));
    return `<div class="post-card">
      <div class="post-card-header">
        <div class="post-avatar">${p.autor.charAt(0).toUpperCase()}</div>
        <div>
          <p class="post-author">${escHtml(p.autor)}</p>
          <p class="post-time">${p.time||'Agora'}</p>
        </div>
        ${currentUser&&currentUser.isAdmin?`<button class="del-post-btn" onclick="delPost(${i})">🗑️ Apagar</button>`:''}
      </div>
      <p class="post-text">${escHtml(p.text)}</p>
      ${p.media&&isImg?`<img src="${p.media}" class="post-media" onerror="this.style.display='none'"/>`:''}
      ${p.media&&!isImg?`<a href="${p.media}" target="_blank" class="post-media-url">🔗 ${p.media}</a>`:''}
      <div class="post-actions">
        <button class="react-btn ${liked?'liked':''}" onclick="reactPost(${i},'like')">👍 ${p.likes}</button>
        <button class="react-btn ${hearted?'hearted':''}" onclick="reactPost(${i},'heart')">❤️ ${p.hearts}</button>
        <button class="react-btn" onclick="toggleComments(${i})">💬 ${p.comments.length}</button>
      </div>
      <div class="comment-section" id="comments-${i}" style="display:none;">
        ${p.comments.map(c=>`<div class="comment"><div class="comment-avatar">${c.autor.charAt(0).toUpperCase()}</div><div class="comment-body"><p class="comment-name">${escHtml(c.autor)}</p><p class="comment-text">${escHtml(c.text)}</p></div></div>`).join('')}
        ${currentUser?`<div class="comment-row"><input class="comment-input" id="cinp-${i}" placeholder="Escreva um comentário..." onkeydown="if(event.key==='Enter')addComment(${i})"/><button class="comment-send" onclick="addComment(${i})">Enviar</button></div>`:'<p style="font-size:12px;color:var(--g);margin-top:8px;font-family:Barlow Condensed,sans-serif;">Faça login para comentar.</p>'}
      </div>
    </div>`;
  }).join('');
}

function criarPost() {
  if(!currentUser) { showAuth('login'); return; }
  const txt = document.getElementById('post-text').value.trim();
  const media = document.getElementById('post-media').value.trim();
  if(!txt) { showToast('⚠️ Escreva algo na publicação!'); return; }
  posts.unshift({id:Date.now(), autor:currentUser.name, text:txt, media, likes:0, hearts:0, comments:[], likedBy:[], heartedBy:[], time: today()});
  document.getElementById('post-text').value='';
  document.getElementById('post-media').value='';
  showToast('✅ Publicação criada!');
  renderPosts();
}

function reactPost(i, type) {
  if(!currentUser) { showAuth('login'); showToast('Faça login para reagir!'); return; }
  const all = [...samplePosts, ...posts];
  const p = all[i];
  const em = currentUser.email;
  if(type==='like') {
    if(p.likedBy.includes(em)) { p.likes--; p.likedBy.splice(p.likedBy.indexOf(em),1); }
    else { p.likes++; p.likedBy.push(em); }
  } else {
    if(p.heartedBy.includes(em)) { p.hearts--; p.heartedBy.splice(p.heartedBy.indexOf(em),1); }
    else { p.hearts++; p.heartedBy.push(em); }
  }
  renderPosts();
  // reopen comments if was open
}

function toggleComments(i) {
  const el = document.getElementById('comments-'+i);
  if(el) el.style.display = el.style.display==='none'?'block':'none';
}

function addComment(i) {
  if(!currentUser) return;
  const inp = document.getElementById('cinp-'+i);
  if(!inp||!inp.value.trim()) return;
  const all = [...samplePosts, ...posts];
  all[i].comments.push({autor:currentUser.name, text:inp.value.trim()});
  renderPosts();
  // reopen
  setTimeout(()=>{ const el=document.getElementById('comments-'+i); if(el)el.style.display='block'; },10);
}

function delPost(i) {
  const idx = i - samplePosts.length;
  if(idx >= 0) posts.splice(idx,1);
  else samplePosts.splice(i,1);
  renderPosts();
  showToast('🗑️ Publicação removida.');
}

// ── UTILS ──
function escHtml(s){ return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
function now(){ const d=new Date(); return d.getHours().toString().padStart(2,'0')+':'+d.getMinutes().toString().padStart(2,'0'); }
function today(){ const d=new Date(); return d.toLocaleDateString('pt-BR'); }
function showToast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(()=>t.classList.remove('show'), 3200);
}

// Init
renderDenuncias();
renderPosts();
</script>
